{
  "name": "target-copy",
  "version": "1.0.0",
  "private": true,
  "description": "Copy Obsidian notes as destination-aware rich text or source-preserving Markdown.",
  "author": "Logan",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "clipboard",
    "markdown",
    "rich-text",
    "wechat"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "release:verify": "node scripts/verify-release.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run release:verify"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
